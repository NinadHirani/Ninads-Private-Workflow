# Environment variables
.env
!.env.example

# Media files & execution artifacts
downloads/*
!downloads/.gitkeep
edited/*
!edited/.gitkeep
archive/*
!archive/.gitkeep
deliverables/*
!deliverables/.gitkeep
tests/*.mp4
*.mp4
*.mov
*.wav
*.mp3
remotion/public/*
!remotion/public/.gitkeep
remotion/props_*.json
logs/*.log
logs/*.db
logs/*.csv
logs/*.pid
logs/*.json
logs/*.lock
logs/STOP
!**/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/
env/

# Google OAuth secrets
client_secret*.json

# OS / Editor files
.DS_Store
.vscode/
.idea/
node_modules/
**/node_modules/
