# AI Shorts Factory Environment Configuration

# Free stock video APIs (at least one): https://www.pexels.com/api/ and https://pixabay.com/api/docs/
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# YouTube OAuth Credentials (YouTube Data API v3)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
# Optional. Defaults to 22 (People & Blogs)
YOUTUBE_CATEGORY_ID=22

# Instagram (posts the same video as a Reel). The session is cached after first login.
IG_USERNAME=your_instagram_username_here
IG_PASSWORD=your_instagram_password_here

# Maximum length of one Short or Reel in seconds (saves processing and upload time)
MAX_DURATION_SECONDS=60

# Editing style: cinematic (smooth, default) or brainrot (push-in zoom, punchier colours)
EDIT_STYLE=cinematic

# Dry run: 1 uses a local sample clip and skips the real upload
SHORTS_MOCK=0

# Paths (Relative to project root or absolute)
DOWNLOAD_PATH=downloads
EDIT_PATH=edited
ARCHIVE_PATH=archive
LOG_PATH=logs

# System Settings
# Max seconds for one FFmpeg edit (raise it on a slow machine)
FFMPEG_TIMEOUT_SEC=600
LOG_LEVEL=INFO
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Channel logo watermark burned into every Short (assets/channel_logo.png ships with the repo; leave LOGO_FILE empty to disable)
LOGO_FILE=assets/channel_logo.png
LOGO_POSITION=bottom_right
LOGO_WIDTH_PCT=15
LOGO_OPACITY=0.85

# Voiceover (story mode): edge-tts voice name (free); Piper model is only the offline fallback
VOICEOVER_VOICE=
PIPER_MODEL=

# Story mode audio: auto lets the story pipeline choose (voiceover + music)
AUDIO_MODE=auto

# Free AI script generation (optional): Groq key first, Gemini fallback; without keys the free pollinations provider is used
GROQ_API_KEY=
GEMINI_API_KEY=

# Offline sample clip for dry runs (default tests/sample.mp4)
SHORTS_SAMPLE_VIDEO=
